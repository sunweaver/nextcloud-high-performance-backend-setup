# This config provides a Nginx config for reverse-proxying HaRP with HTTP and HTTPS.
# https://github.com/nextcloud/HaRP

# idx   = {{IDX}}
# LOCAL = {{HARP_PORT_BASE}}+2*idx            = {{HARP_PORT_BASE_PLUS_IDX_TIMES_2}}
# HTTP  = {{HARP_EXTERNAL_PORT_BASE}}+2*idx   = {{HARP_EXTERNAL_PORT_BASE_PLUS_IDX_TIMES_2}}
# HTTPS = {{HARP_EXTERNAL_PORT_BASE}}+2*idx+1 = {{HARP_EXTERNAL_PORT_BASE_PLUS_IDX_TIMES_2_PLUS_1}}

server {
  listen 0.0.0.0:{{HARP_EXTERNAL_PORT_BASE_PLUS_IDX_TIMES_2}};
  listen [::]:{{HARP_EXTERNAL_PORT_BASE_PLUS_IDX_TIMES_2}} ipv6only=on;
  server_name {{SERVER_FQDN}};

  return 301 https://$host:{{HARP_EXTERNAL_PORT_BASE_PLUS_IDX_TIMES_2_PLUS_1}}$request_uri;

  access_log  /var/log/nginx/HARP_{{PROJECT_NAME}}_access.log;
  error_log   /var/log/nginx/HARP_{{PROJECT_NAME}}_error.log;
}

server {
  listen 0.0.0.0:{{HARP_EXTERNAL_PORT_BASE_PLUS_IDX_TIMES_2_PLUS_1}} ssl;
  listen [::]:{{HARP_EXTERNAL_PORT_BASE_PLUS_IDX_TIMES_2_PLUS_1}} ipv6only=on ssl;

  ## Strong SSL Security
  # RSA certificates
  ssl_certificate {{SSL_CERT_PATH_RSA}};
  ssl_certificate_key {{SSL_CERT_KEY_PATH_RSA}};
  # ECC certificates
  ssl_certificate {{SSL_CERT_PATH_ECDSA}};
  ssl_certificate_key {{SSL_CERT_KEY_PATH_ECDSA}};

  ssl_trusted_certificate {{SSL_CHAIN_PATH_ECDSA}};

  ssl_dhparam {{DHPARAM_PATH}};

  # Backup self-signed SSL-certs.
  # include snippets/snakeoil.conf;

  ssl_protocols TLSv1.2 TLSv1.3;

  # SSL ciphers: RSA + ECDSA
  # Two certificate types (ECDSA, RSA) are needed.
  ssl_ciphers 'TLS-CHACHA20-POLY1305-SHA256:TLS-AES-256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384';

  ssl_ecdh_curve secp521r1:secp384r1;
  ssl_prefer_server_ciphers on;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 5m;
  ssl_session_tickets off;
  ssl_stapling on;
  ssl_stapling_verify on;
  resolver {{DNS_RESOLVER}};

  include /etc/nginx/snippets/headers.conf;

  server_name {{SERVER_FQDN}};

  # security - prevent information disclosure about server version
  server_tokens off;

  access_log  /var/log/nginx/HARP_{{PROJECT_NAME}}_access.log;
  error_log   /var/log/nginx/HARP_{{PROJECT_NAME}}_error.log;

  location /exapps/ {
    proxy_pass http://127.0.0.1:{{HARP_PORT_BASE_PLUS_IDX_TIMES_2}};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
  }
}
